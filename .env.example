# .env.example – Docker environment variables for MCP Server.
#
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# Only DISCORD_GENERAL_HOOK is required.  The rest have sensible fallbacks
# inside discord.sh when left unset.

# ── Discord ───────────────────────────────────────────────────────────
# Your Discord webhook URL (required for the discord command to work).
# Create one at: Server Settings → Integrations → Webhooks → New Webhook
# The URL must end with ?wait=true
DISCORD_GENERAL_HOOK=https://discord.com/api/webhooks/XXXXXXXXX/YYYYYYYYY?wait=true

# Optional: override the bot display name (defaults to hostname).
#DISCORD_SERVER_NAME=my-server

# Optional: suffix appended to every message title
# (defaults to "· $DISCORD_SERVER_NAME").
#DISCORD_TITLE_SUFFIX="· my-server"

# Optional: separate webhook for alerts (defaults to DISCORD_GENERAL_HOOK).
#DISCORD_ALERT_HOOK=https://discord.com/api/webhooks/XXXXXXXXX/ZZZZZZZZZ?wait=true

# ── Server ────────────────────────────────────────────────────────────
# Optional: timezone for the container (defaults to UTC).
#TZ=America/New_York

# Optional: API key for securing MCP endpoints.
# When set, all endpoints except /health require an X-API-Key header
# matching this value.  Leave unset for open access (local dev).
#MCP_API_KEY=your-secret-key-here

# ── Logging ──────────────────────────────────────────────────────────
# Optional: path to the log file used by the `log` and `log_read` commands.
# If unset, falls back to MCP_LOG_DIR/mcp.log, then /tmp/mcp/mcp.log.
#MCP_LOG_FILE=/var/log/mcp/mcp.log

# Optional: directory for the log file (used when MCP_LOG_FILE is unset).
#MCP_LOG_DIR=/var/log/mcp

# ── CalDAV ───────────────────────────────────────────────────────────
# Optional: CalDAV server for calendar events and tasks.
# When CALDAV_URL is set, /calendars, /events, and /tasks endpoints are enabled.
# The editable calendar is where events/tasks can be created/updated/deleted.
# All other calendars (or those listed in CALDAV_READONLY_CALENDARS) are read-only.
#CALDAV_URL=https://caldav.example.com/dav
#CALDAV_USERNAME=user
#CALDAV_PASSWORD=secret
#CALDAV_EDITABLE_CALENDAR=Lyra
# Optional: comma-separated list of read-only calendar names to include.
# If empty, all calendars except the editable one are included as read-only.
#CALDAV_READONLY_CALENDARS=Personal,Work
