# .env.example – Environment variables for MCP Server.
#
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# The server needs at least one feature configured to start:
#   - A registry command (any YAML in registry/)
#   - Discord webhook (DISCORD_INFO_HOOK, etc.)
#   - Ntfy server (NTFY_URL + NTFY_*_TOPIC)
#   - CalDAV calendar (CALDAV_URL)
#   - ICS calendar feed (ICS_CALENDAR_URL)
#   - Gitea instance (GITEA_URL)
#   - Weather location (WEATHER_LOCATION)
# If nothing is configured, the server refuses to start.

# ── Notify / Discord ──────────────────────────────────────────────────
# Discord webhooks, one per severity level (low → high).
# At least one must be configured for the /notify endpoint to work.
# Create at: Server Settings → Integrations → Webhooks → New Webhook
# URLs should end with ?wait=true for delivery confirmation.
#
# If a webhook for the requested level is not configured, the system
# falls back to the nearest lower configured level.  For example, if
# only INFO and CRITICAL are set, an EMERGENCY notification goes to
# CRITICAL, and a NOTICE notification goes to INFO.
#DISCORD_INFO_HOOK=https://discord.com/api/webhooks/XXXXXXXXX/INFO?wait=true
#DISCORD_NOTICE_HOOK=https://discord.com/api/webhooks/XXXXXXXXX/NOTICE?wait=true
#DISCORD_CRITICAL_HOOK=https://discord.com/api/webhooks/XXXXXXXXX/CRITICAL?wait=true
#DISCORD_EMERGENCY_HOOK=https://discord.com/api/webhooks/XXXXXXXXX/EMERGENCY?wait=true

# Optional: override the bot display name (defaults to hostname).
#DISCORD_SERVER_NAME=my-server

# Optional: suffix appended to every message title.
#DISCORD_TITLE_SUFFIX="· my-server"

# ── Notify / Ntfy ────────────────────────────────────────────────────
# Ntfy is an alternative (or additional) notify provider.
# Requires a self-hosted ntfy server or the public https://ntfy.sh.
#
# The base URL of the ntfy server (no trailing slash needed).
#NTFY_URL=https://ntfy.example.com
#
# Topics, one per severity level (low → high).
# At least one must be configured for the ntfy provider to activate.
# Each level can publish to a different topic so you can subscribe to
# only the severities you care about on your devices.
#
# If a topic for the requested level is not configured, the system
# falls back to the nearest lower configured level (same as Discord).
#NTFY_INFO_TOPIC=myserver-info
#NTFY_NOTICE_TOPIC=myserver-notice
#NTFY_CRITICAL_TOPIC=myserver-critical
#NTFY_EMERGENCY_TOPIC=myserver-emergency
#
# Authentication (choose one method):
#   Token-based: generate an access token in ntfy's admin UI.
#NTFY_TOKEN=tk_xxxxxxxxxxxxxxxxxxxxxxxx
#
#   Basic auth: username and password.
#NTFY_USERNAME=andrew
#NTFY_PASSWORD=secret
#
# Optional: suffix appended to every message title.
#NTFY_TITLE_SUFFIX="· my-server"
#
# Color is conveyed via ntfy named tags (red_circle, blue_circle, etc.)
# which ntfy renders as emoji on the client side, since ntfy does not
# support embed colors like Discord.

# ── Weather ──────────────────────────────────────────────────────────
# Optional: weather data enrichment via Open-Meteo (free, no API key).
# When WEATHER_LOCATION is set, GET /weather returns current conditions
# and a multi-day forecast for the configured location.
# Format: "lat,long" (e.g. "45.5,-122.6" for Portland, OR).
#WEATHER_LOCATION=45.5,-122.6

# ── Server ────────────────────────────────────────────────────────────
# Optional: timezone for the container (defaults to UTC).
#TZ=America/New_York

# Optional: API key for securing MCP endpoints.
# When set, all endpoints except /api/health require an X-API-Key header
# matching this value.  Leave unset for open access (local dev).
#MCP_API_KEY=your-secret-key-here

# ── Registry ─────────────────────────────────────────────────────────
# Optional: directory containing command registry YAML files.
# Defaults to the 'registry/' directory inside the project root.
#MCP_REGISTRY_DIR=/app/registry

# ── Logging ──────────────────────────────────────────────────────────
# Optional: path to the log file used by the `log` and `log_read` commands.
# If unset, falls back to MCP_LOG_DIR/mcp.log, then /tmp/mcp/mcp.log.
#MCP_LOG_FILE=/var/log/mcp/mcp.log

# Optional: directory for the log file (used when MCP_LOG_FILE is unset).
#MCP_LOG_DIR=/var/log/mcp

# Optional: log level for the MCP application (default: INFO).
# Set to DEBUG to see health-check access logs and other verbose output.
# At the default INFO level, /api/health request logs are suppressed to
# avoid flooding the output (the docker-compose healthcheck polls every 30s).
#MCP_LOG_LEVEL=INFO

# Optional: set to false to disable logging entirely.
# When disabled, the `log` and `log_read` endpoints are not registered —
# they won't appear in GET /commands and no routes are generated.
# Useful in ephemeral containers where you don't want log files to accumulate.
#MCP_LOG_ENABLED=true

# ── CalDAV ───────────────────────────────────────────────────────────
# Optional: CalDAV server for calendar events and tasks.
# When CALDAV_URL is set, /events, /calendars, and /tasks endpoints are enabled.
# When CALDAV_EDITABLE_CALENDAR is unset (or empty), all calendars are
# read-only and no create/update/delete endpoints are registered.
# When set, only that calendar is writable; all others are read-only.
#CALDAV_URL=https://caldav.example.com/dav
#CALDAV_USERNAME=user
#CALDAV_PASSWORD=secret
#CALDAV_EDITABLE_CALENDAR=MyCalendar
# Optional: comma-separated list of read-only calendar names to include.
# If empty, all calendars except the editable one are included as read-only.
#CALDAV_READONLY_CALENDARS=Personal,Work

# ── ICS Calendar (read-only) ───────────────────────────────────────
# Optional: read-only ICS calendar feed (e.g. Outlook published calendar).
# When ICS_CALENDAR_URL is set, ICS events are merged into the unified
# /events endpoint and /calendars/refresh is enabled.
#ICS_CALENDAR_URL=https://outlook.office365.com/owa/calendar/.../calendar.ics
#ICS_CALENDAR_NAME=Work
# Optional: seconds between cache refreshes (default: 300, minimum: 30).
#ICS_REFRESH_INTERVAL=300

# ── Gitea ────────────────────────────────────────────────────────────
# Optional: Gitea server for issue/PR/release management.
# When GITEA_URL is set, /issues, /prs, /branches, /actions, /releases
# endpoints are enabled.
# Generate a token at: Settings → Applications → Generate New Token
# Token needs 'repo' scope (read/write to repos, issues, PRs).
#GITEA_URL=https://code.example.com
#GITEA_TOKEN=your-api-token
#GITEA_DEFAULT_OWNER=your-username
#GITEA_DEFAULT_REPO=your-repo

# Optional: expose Gitea issues related tools
#MCP_GITEA_ISSUES=1

# Optional: expose Gitea releases related tools
#MCP_GITEA_RELEASES=1

# Optional: expose niche Gitea tools in the OpenAPI schema.
# When enabled, /repos/.../compare, /prs/{index}/reviews, and
# /commits/{sha}/statuses are visible to the LLM.  Disabled by default
# to reduce tool schema token count.
#MCP_GITEA_EXTRA_TOOLS=1
