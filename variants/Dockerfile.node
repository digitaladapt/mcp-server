# ── MCP Server – Node.js Variant ───────────────────────────────────────
# Layers Node.js on top of the base mcp-server image so registry
# definitions can wrap Node scripts and npm-installed CLIs.
#
# Build (from repo root):
#   docker build -f variants/Dockerfile.node -t mcp-server:node .
#
# Run:
#   docker run -p 8000:8000 \
#     -v ./registry:/app/registry \
#     -v ./config.sh:/app/config.sh:ro \
#     mcp-server:node
# ────────────────────────────────────────────────────────────────────────

FROM mcp-server:latest

# Switch to root to install system packages.
USER root

# Install Node.js 22.x LTS from nodesource (Debian's default is too old).
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        gnupg \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
       | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" \
       > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && node --version && npm --version

# Drop back to the non-root user.
USER mcp
