#!/usr/bin/env bash
# Discord webhook configuration for the notify system.
#
# Copy to config.sh and fill in your webhook URLs.
# At least one hook is required.  URLs should end with ?wait=true.
#
# Webhooks are per severity level (low → high).  If a level's hook
# is not set, it falls back to the nearest lower configured level.

DISCORD_INFO_HOOK="<WEBHOOK_URL_HERE>?wait=true"
DISCORD_NOTICE_HOOK="<WEBHOOK_URL_HERE>?wait=true"
#DISCORD_CRITICAL_HOOK="<WEBHOOK_URL_HERE>?wait=true"
#DISCORD_EMERGENCY_HOOK="<WEBHOOK_URL_HERE>?wait=true"

# Optional: bot display name and title suffix.
#DISCORD_SERVER_NAME="my-server"
#DISCORD_TITLE_SUFFIX="· my-server"
